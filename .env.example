# AVEL factory server: environment variables.
#
# Copy to .env.local (ignored by git) for local runs. Never commit a real value.
# Grouped by the build step that first needs each one; leave later steps empty until then.
# Names are proposals until the ticket that reads them lands; that ticket updates this file.
#
# This file is for the SERVER. The build team's keys (Claude Code, OSA, GitHub) live in
# ~/.config/avel/*.env on your machine, never here. See docs/design/Build roster and environment.md.
#
# Never put ANTHROPIC_API_KEY (the factory's model key) in your shell profile: Claude Code reads that
# variable too, and your build sessions would bill the factory's key.

# ── Step 1: server shell, sign-in, jobs, events, factory repo loader ──────────────────────────────
DATABASE_URL=                 # export DATABASE_URL=$(scripts/pg-local.sh start)
PORT=                         # the server's port
LOG_LEVEL=info
BETTER_AUTH_SECRET=           # 32+ random bytes: openssl rand -base64 32
BETTER_AUTH_URL=              # the server's public base URL, e.g. http://localhost:<PORT>
AVEL_OPERATOR_EMAIL=          # read once by the seed; the password is typed at its prompt, never stored
AVEL_FACTORY_REPO_URL=        # the private factory repo (factory.yaml, skills, rules), loaded by commit SHA
AVEL_FACTORY_REPO_TOKEN=      # fine-grained GitHub token: Contents read-only, that one repo
GITHUB_WEBHOOK_SECRET=        # the secret on the factory repo's webhook (POST /api/webhooks/github)

# ── Step 2: host, rooms, model proxy, egress proxy ───────────────────────────────────────────────
ANTHROPIC_API_KEY=            # held ONLY by the model proxy process; its own Console workspace with a spend limit
AVEL_MODEL_PROXY_URL=         # where rooms and Canon reach the proxy
AVEL_EGRESS_PROXY_URL=        # the rooms' only way out
AVEL_ROOM_RUNTIME=runsc       # gVisor; needs a Linux host
MIOSA_API_KEY=                # only if rooms run on MIOSA (CR-22: internal and template missions only)

# ── Step 3: receipts ─────────────────────────────────────────────────────────────────────────────
AVEL_RECEIPT_SIGNING_KEY_ID=  # an asymmetric signing key in AWS KMS, so the private key never leaves KMS

# ── Step 4: secrets, repo connections, delivery ──────────────────────────────────────────────────
AWS_REGION=
AVEL_KMS_KEY_ID=              # the symmetric key for envelope encryption (secrets table)
AWS_PROFILE=                  # avel-server for the main service; avel-delivery for the delivery worker
# Client GitHub tokens are NOT environment variables: you enter them in the app (with step-up),
# and they're stored envelope-encrypted. Only the delivery worker can decrypt write tokens.

# ── Step 7: Gate 0 (Canon) ───────────────────────────────────────────────────────────────────────
AVEL_BLOB_STORE=              # where uploads live; set when the Drive storage port lands (backend to confirm)
AVEL_TRANSCRIBE_PROVIDER=     # voice clips to text (CR-W19); provider not chosen yet
AVEL_TRANSCRIBE_API_KEY=

# ── Later ────────────────────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=             # a second vendor for Retry 3 (CR-5), held only by the model proxy
# MAIL_*=                     # a mail service, once AVEL has a sending address
