{
  "name": "avel-factory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
    "typecheck": "tsc -p tsconfig.json && TURBO_TELEMETRY_DISABLED=1 turbo run typecheck",
    "lint": "biome check .",
    "test": "TURBO_TELEMETRY_DISABLED=1 turbo run build && vitest run --config vitest.workspace.ts --passWithNoTests",
    "typecheck:control-room": "tsc -p apps/web/tsconfig.control-room.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "22.20.5",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
