{
  "compilerOptions": {
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": [],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "@effect/language-service" }]
  },
  "include": ["bad", "clean"]
}
