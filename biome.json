{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/node_modules", "!**/dist", "!docs", "!scripts", "!.claude"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/contract/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Classic zod is banned in packages/contract (decisions.md S1-6): import * as z from \"zod/mini\" (or zod/v4/core for types and classes shared with classic).",
                  "zod/v4": "Classic zod is banned in packages/contract (decisions.md S1-6): import * as z from \"zod/mini\" (or zod/v4/core for types and classes shared with classic)."
                }
              }
            }
          }
        }
      }
    }
  ]
}
