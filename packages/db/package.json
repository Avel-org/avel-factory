{
  "name": "@avel/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AVEL's database: the Drizzle schema rebuilt from the database map, the table-owner map, and the drizzle-kit migrations.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate:up": "node --experimental-strip-types src/migrate.ts up",
    "migrate:down": "node --experimental-strip-types src/migrate.ts down"
  },
  "dependencies": {
    "@avel/contract": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
